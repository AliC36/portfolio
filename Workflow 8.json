    {
      "parameters": {
        "jsCode": "const data = items[0].json;\n\nconst titles     = Array.isArray(data.title) ? data.title : [data.title];\nconst thumbnails = Array.isArray(data.thumbnail) ? data.thumbnail : [data.thumbnail];\nconst prices     = Array.isArray(data.price) ? data.price : [data.price];\n\n// produkt-url kann anders heißen: probiere mehrere keys\nconst rawUrl =\n  data.product_url ?? data.productUrl ?? data.url ?? data.link ?? data.productLink;\n\n// zu Array normalisieren\nlet productUrls = Array.isArray(rawUrl) ? rawUrl : [rawUrl];\n\n// Wenn nur 1 URL da ist, aber mehrere Titel: URL \"auffüllen\"\nif (productUrls.length === 1 && titles.length > 1) {\n  productUrls = Array(titles.length).fill(productUrls[0]);\n}\n\nconst count = titles.length;\n\nconst newItems = [];\nfor (let i = 0; i < count; i++) {\n  newItems.push({\n    json: {\n      title: titles[i] ?? null,\n      thumbnail: thumbnails[i] ?? thumbnails[0] ?? null,\n      price: prices[i] ?? prices[0] ?? null,\n      product_url: productUrls[i] ?? productUrls[0] ?? null,\n    },\n  });\n}\n\nreturn newItems;\n"
      },
